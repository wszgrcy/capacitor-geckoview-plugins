{
  "name": "capacitor-plugins",
  "version": "8.5.6",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/wszgrcy/capacitor-geckoview-plugins"
  },
  "author": {
    "name": "wszgrcy",
    "email": "wszgrcy@gmail.com"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "watch": "pnpm -r --parallel run watch",
    "lint": "npm run scripts:prettier -- --check",
    "fmt": "npm run scripts:prettier -- --write && pnpm -r run fmt",
    "scripts:prettier": "npx prettier \"scripts/**/*.mjs\"",
    "apply-patches": "node ./scripts/apply-patches.mjs",
    "toggle-local": "node ./scripts/toggle-local.mjs",
    "update-all": "node ./scripts/update-all.mjs",
    "set-capacitor-version": "node ./scripts/set-capacitor-version.mjs",
    "set-settings-gradle-for-monorepo": "node ./scripts/monorepo-tools/android-settings-gradle-fix.mjs",
    "publish:cocoapod": "pnpm -r run publish:cocoapod",
    "publish": "node ./scripts/publish.mjs",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s"
  },
  "devDependencies": {
    "@actions/core": "^1.11.1",
    "@actions/http-client": "^3.0.0",
    "@ionic/prettier-config": "^4.0.0",
    "@types/node": "^24.10.1",
    "@types/prompts": "^2.4.9",
    "conventional-changelog": "^7.1.1",
    "cross-spawn": "^7.0.6",
    "execa": "^9.6.0",
    "glob": "^11.0.3",
    "yaml": "^2.9.0",
    "prettier": "^3.6.2",
    "prompts": "^2.4.2",
    "typescript": "^5.9.3"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": {
    "identifier_name": {
      "min_length": 1
    }
  }
}
